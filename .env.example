# ===== Application =====
NODE_ENV=production
ORIGIN=https://sensore.senify.de
SERVICE_PORT=80

# ===== Database (External MySQL) =====
# Format: mysql://username:password@host:port/database
# For MySQL on Docker host: host.docker.internal
# For external MySQL: use actual hostname/IP
DATABASE_URL=mysql://user:password@host.docker.internal:3306/senify

# ===== Security =====
BCRYPT_ROUNDS=12
ENCRYPTION_KEY=your-32-character-encryption-key-here
MQTT_PASSWORD=your-secure-mqtt-password-here
PLANE_API_KEY=your-plane-api-key-here

# ===== MQTT Configuration =====
MQTT_PORT=8883

# ===== Inter-Service RPC URLs (host:port) =====
# Used by sensoren-server to reach other services
BROKER_RPC_URL=broker-service:8081
WSS_RPC_URL=websocket-service:8091
BACKUP_RPC_URL=backup-service:8101

# ===== Coolify Auto-Generated =====
# This will be automatically set by Coolify based on your domain configuration
SERVICE_FQDN_SENIFY_3000=sensore.senify.de
