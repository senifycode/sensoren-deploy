# Copy this file to .env and fill in your values.
# docker compose -f docker-compose.local.yml up --build

# ── Database ────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=root1234
MYSQL_DATABASE=senify
MYSQL_USER=prisma
MYSQL_PASSWORD=Prisma123!
DATABASE_URL=mysql://prisma:Prisma123!@db:3306/senify

# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
ORIGIN=http://localhost:3000
BCRYPT_ROUNDS=10

# ── MQTT ─────────────────────────────────────────────────────────────────────
MQTT_PASSWORD=test1234
MQTT_PORT=1883

# ── Encryption ───────────────────────────────────────────────────────────────
ENCRYPTION_KEY=localtestkey1234567890123456789012

# ── External APIs ─────────────────────────────────────────────────────────────
PLANE_API_KEY=

# ── gRPC service URLs (host:port, resolved inside Docker network) ─────────────
BROKER_RPC_URL=broker-service:8081
WSS_RPC_URL=websocket-service:8091
WSS_SERVICE_URL=http://websocket-service:8081
BACKUP_RPC_URL=backup-service:8101
